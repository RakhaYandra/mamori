# Maintainer: Rakha Yandra <rakhaputrapebriyandra272@gmail.com>
pkgname=mamori-bin
pkgver=0.1.1
pkgrel=1
pkgdesc="Local-first Linux security auditor: secrets, Git exposure, permissions, SSH"
arch=('x86_64' 'aarch64')
url="https://github.com/RakhaYandra/mamori"
license=('MIT')
provides=('mamori')
conflicts=('mamori')
optdepends=('git: Git inspection and pre-commit hook')
source=("SHA256SUMS::https://github.com/RakhaYandra/mamori/releases/download/v${pkgver}/SHA256SUMS")
source_x86_64=("mamori-linux-amd64::https://github.com/RakhaYandra/mamori/releases/download/v${pkgver}/mamori-linux-amd64")
source_aarch64=("mamori-linux-arm64::https://github.com/RakhaYandra/mamori/releases/download/v${pkgver}/mamori-linux-arm64")
sha256sums=('SKIP')
sha256sums_x86_64=('00235e655e38604a1905f5c3393e7b1c6670e3fd1da531fe01a2243322e357e8')
sha256sums_aarch64=('6c8dc9c75763429901efb5808a296e6badcf07ea7bf11f3031ab31cc01a8f4f0')

package() {
  case "$CARCH" in
    x86_64) bin=mamori-linux-amd64 ;;
    aarch64) bin=mamori-linux-arm64 ;;
  esac

  install -Dm755 "$bin" "$pkgdir/usr/bin/mamori"

  # Release binaries ship without the exec bit; set it before generating docs.
  chmod +x "$bin"

  # Completions and man pages are generated by the binary itself,
  # so release tarballs need no extra assets.
  "./$bin" completion bash | install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/mamori"
  "./$bin" completion zsh | install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_mamori"
  "./$bin" completion fish | install -Dm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/mamori.fish"
  mkdir -p man
  "./$bin" man --dir man
  install -Dm644 man/*.1 -t "$pkgdir/usr/share/man/man1/"
}
